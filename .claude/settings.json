      "Bash(gh workflow run *)",
      "Bash(ls *)",
      "Bash(sleep *)",
      "Bash(curl -s http://localhost:5173/*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(git push * --force-with-lease)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(/.github/**)",
      "Edit(/.claude/**)",
      "Edit(/scripts/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ]
  }
